# ─── External services ───
GEMINI_API_KEY=your-gemini-api-key
FEATHERLESS_API_KEY=your-featherless-api-key
SPEECHMATICS_API_KEY=your-speechmatics-api-key

# ─── Database ───
DATABASE_URL=postgresql://sentry:sentry@localhost:5432/sentry
EVENT_STORE_PATH=./var/event_store.db

# ─── API ───
SENTRY_API_HOST=0.0.0.0
SENTRY_API_PORT=8088
SENTRY_API_WORKERS=2

# ─── Capture proxy ───
CAPTURE_PROXY_PORT=8089

# ─── Voice tap ───
VOICE_TAP_PORT=8090

# ─── Severity policies ───
ADVISORY_THRESHOLD=0.5
WARNING_THRESHOLD=0.7
CRITICAL_THRESHOLD=0.85
CRITICAL_REQUIRES_CONSENSUS=3

# ─── Featherless model routing ───
MODEL_EU_AI_ACT=meta-llama/Llama-3.1-8B-Instruct
MODEL_GDPR=mistralai/Mistral-7B-Instruct-v0.3
MODEL_DORA=meta-llama/Llama-3.1-8B-Instruct
MODEL_PII=microsoft/Phi-3.5-mini-instruct
MODEL_PROMPT_INJECTION=Qwen/Qwen2.5-7B-Instruct

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FORMAT=json
